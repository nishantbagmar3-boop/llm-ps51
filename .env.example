# ============================================================================
# TEMPLATE ONLY — never put real values in this file.
# This file IS committed to git. Copy values into the file named `.env`
# (same folder), which is git-ignored and never leaves this machine.
# ============================================================================

# ----- LLM configuration (required to run the app) --------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ----- Student details (used only to generate the submission Report.pdf) ----
STUDENT_NAME=
STUDENT_ROLL_NUMBER=
STUDENT_CLASS=

# ----- GitHub submission (used once, for creating/pushing the repo) ---------
# The repository will be named: llm-ps51-<STUDENT_ROLL_NUMBER>
GITHUB_USERNAME=
GITHUB_EMAIL=
# Personal Access Token with repository write access (GitHub no longer accepts
# account passwords for git pushes). Create one at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ----- Git commit author (falls back to STUDENT_NAME / GITHUB_EMAIL) --------
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
